# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv
venv/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# Thesis - sources are tracked; build artefacts and source-paper PDFs are not.
# (*.aux, *.log, *.out, *.bbl, *.synctex.gz, *.pdf, *.txt are already covered by the
#  global patterns further down; these are the LaTeX artefacts that are not.)
Thesis/*.bcf
Thesis/*.run.xml
Thesis/*.toc
Thesis/*.xdv
Thesis/*.fdb_latexmk
Thesis/*.fls
Thesis/*.synctex*
Thesis/*.lof
Thesis/*.lot
Thesis/references/
Thesis/citations/
# NOTE: the thesis figures are re-included AFTER the global *.png rule below
# (in gitignore the last matching pattern wins, so the negation must come later).

# Large data files - DO NOT COMMIT
# These should be generated by running the pipeline
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
data/

# Model weights and training artifacts - DO NOT COMMIT
# Delete these after training, models can be retrained
models/
*.joblib
*.joblib.z*
*.weights.h5
*.weights
*.keras
*.pth
*.pt

# Results and logs - generated by pipeline
results/
execution_logs/
*.log
*.txt

# Generated files
*.png
*.jpg
*.jpeg
*.pdf
*.aux
*.blg
*.synctex.gz
*.out
*.bbl

# Thesis figures - re-included here, after the global *.png rule above.
!Thesis/images/*.png
!Thesis/images/*.svg

# OS files
Thumbs.db
